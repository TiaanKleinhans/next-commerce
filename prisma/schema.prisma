generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductModel {
  id    String @id @default(cuid())
  isArchived Boolean @default(false)
  dateCreated  DateTime @default(now())
    
  name  String
  description String?
  available Int @default(0)
  category CategoryModel @relation(fields: [categoryId], references: [id])
  categoryId String
  sellingPrice Decimal @default(0)

  images ImagesModel[]
}

model CategoryModel{
  id    String @id @default(cuid())
  isArchived Boolean @default(false)
  dateCreated  DateTime @default(now())

  name String
  slug String @unique
  products ProductModel[]
}

model LookupTypeModel {
  id String @id @default(cuid())
  isArchived Boolean @default(false)
  dateCreated  DateTime @default(now())

  name  String @unique
  lookups LookupModel[]
}

model LookupModel {
  id    String @id @default(cuid())
  isArchived Boolean @default(false)
  dateCreated  DateTime @default(now())
  value String

  lookupTypeId String
  lookupType LookupTypeModel @relation(fields: [lookupTypeId], references: [id])
}

model ImagesModel {
id String @id @default(cuid())
isArchived Boolean @default(false)
dateCreated  DateTime @default(now())
url String
productId String
product ProductModel @relation(fields: [productId], references: [id])
isDefault Boolean @default(false)
sortOrder Int? 
}

